      "css": ".ds-key-plate{appearance:none;border:0;padding:0;background:transparent;border-radius:2px;width:100%;cursor:pointer}.ds-key-face{display:grid;place-items:center;height:88px;border-radius:2px;font-family:\"Barlow Condensed\",sans-serif;font-weight:800;letter-spacing:0.12em;text-transform:uppercase;font-size:1.05rem;color:#d7e6ea;text-shadow:0 1px 0 #05090c,0 2px 0 #000;background:repeating-radial-gradient(circle at 3px 3px,#4ad0ee 0 1.2px,transparent 1.6px 8px),linear-gradient(180deg,#1a4a58,#0a2028);border:1px solid #6d757c}.ds-key-plate:hover .ds-key-face{filter:brightness(1.12)}.ds-key-plate:active:not(:disabled){transform:translateY(1px)}.ds-key-plate:focus-visible{outline:none;box-shadow:0 0 0 2px #0e1418,0 0 0 4px #1aa3c4}.ds-key-plate:disabled{opacity:0.45;cursor:not-allowed}"
