      "css": ".ds-cats{display:flex;flex-wrap:wrap;gap:4px}.ds-cat{appearance:none;border:1px solid #2c383e;background:#1c2328;color:#d7e6ea;font-family:\"Barlow Condensed\",sans-serif;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;font-size:0.72rem;padding:6px 8px;border-radius:2px;cursor:pointer}.ds-cat:hover{border-color:#1aa3c4}.ds-cat.is-on,.ds-cat[aria-pressed=\"true\"]{background:#c45c2a;color:#1a0e08;border-color:#7a3514}.ds-cat:focus-visible{outline:none;box-shadow:0 0 0 2px #0e1418,0 0 0 4px #1aa3c4}"
