    {
      "name": "Name Bar",
      "kind": "nav",
      "refersTo": "namebar",
      "description": "Full-width aluminum fascia with extruded condensed mark and cyan period keys.",
      "html": "<header class=\"ds-namebar\"><span class=\"ds-mark\">Counter Books</span><div class=\"ds-period\"><button type=\"button\" class=\"ds-period-btn is-on\">Today</button><button type=\"button\" class=\"ds-period-btn\">All</button></div></header>",
      "css": ".ds-namebar{display:flex;align-items:center;gap:16px;min-height:64px;padding:0 18px;border-radius:2px;color:#1a1e22;background:linear-gradient(180deg,rgb(255 255 255 / 0.12),rgb(14 20 24 / 0.22)),repeating-radial-gradient(circle at 14px 12px,#6a7278 0 3px,#8a9298 4px 6px,transparent 7px 28px),linear-gradient(90deg,#9aa4aa,#c5ccd1 40%,#8e969c);box-shadow:inset 0 1px 0 rgb(255 255 255 / 0.35)}.ds-mark{font-family:\"Barlow Condensed\",sans-serif;font-weight:800;font-size:1.85rem;letter-spacing:0.12em;text-transform:uppercase;line-height:1.1;color:#f3f6f8;text-shadow:0 1px 0 #8b9399,0 2px 0 #5c6369,0 3px 0 #2a3034,0 4px 1px #111}.ds-period{display:flex;margin-left:auto;background:#1c2328;padding:3px;border-radius:2px}.ds-period-btn{appearance:none;border:0;background:transparent;color:#9aa8ae;font-family:\"Barlow Condensed\",sans-serif;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;font-size:0.78rem;padding:7px 12px}.ds-period-btn.is-on,.ds-period-btn:hover{background:#1aa3c4;color:#0e1418}.ds-period-btn:focus-visible{outline:none;box-shadow:0 0 0 2px #0e1418,0 0 0 4px #1aa3c4}"
    },
    {
      "name": "Fascia Module",
      "kind": "custom",
      "refersTo": "fascia-module",
      "description": "Equal LED acrylic plate for profit, cash, or stock. Ice figures on a cyan module pitch.",
      "html": "<article class=\"ds-module\"><h2>Profit</h2><p class=\"ds-figure\">Rs 13,350</p><p class=\"ds-hint\">Sales minus cost minus spend</p></article>",
      "css": ".ds-module{position:relative;min-height:126px;padding:16px 16px 12px;border-radius:2px;overflow:hidden;border:1px solid #1c2a30;background:repeating-radial-gradient(circle at 3px 3px,#3ec8e8 0 1.4px,transparent 1.8px 9px),linear-gradient(180deg,#123038,#0a181c);color:#d7e6ea}.ds-module h2{margin:0;font-family:\"Barlow Condensed\",sans-serif;font-weight:700;letter-spacing:0.22em;text-transform:uppercase;font-size:0.82rem;color:#eef6f8;line-height:1.15;text-shadow:0 1px 2px #05090c,0 0 10px rgb(0 0 0 / 0.8)}.ds-figure{margin:8px 0 0;font-family:\"Barlow Condensed\",sans-serif;font-weight:800;font-size:clamp(1.8rem,3.4vw,2.7rem);letter-spacing:0.02em;line-height:1.05;font-variant-numeric:tabular-nums;color:#d7e6ea;text-shadow:0 1px 0 #0a1216,0 2px 0 #05090c,0 0 10px rgb(5 9 12 / 0.8)}.ds-hint{margin:4px 0 0;font-size:0.78rem;color:#c5dbe0;font-family:\"Barlow\",sans-serif}.ds-module:hover{filter:brightness(1.08)}.ds-module:focus-visible{outline:none;box-shadow:0 0 0 2px #0e1418,0 0 0 4px #1aa3c4}"
    },
